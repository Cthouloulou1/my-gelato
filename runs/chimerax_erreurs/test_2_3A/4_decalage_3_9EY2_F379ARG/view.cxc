# Session generee par make_error_examples.py
# Decalage : bon squelette et bon rotamere, atomes deplaces (forme 0.38 A apres superposition)
# gris epais : vrai residu ; gris fin : vrais voisins +/-3 ; bleu : hybride, orange : hybrid_chain_pep
close session
set bgColor white
lighting soft
graphics silhouettes true width 1.5
open "/home/eyerly/dev/my-gelato/runs/chimerax_erreurs/test_2_3A/4_decalage_3_9EY2_F379ARG/vrai.cif" name vrai
open "/home/eyerly/dev/my-gelato/runs/chimerax_erreurs/test_2_3A/4_decalage_3_9EY2_F379ARG/hybride.cif" name hybride
open "/home/eyerly/dev/my-gelato/runs/chimerax_erreurs/test_2_3A/4_decalage_3_9EY2_F379ARG/hybrid_chain_pep.cif" name hybrid_chain_pep
cartoon hide
hide atoms
show #1-3 atoms
style #1-3 stick
size #1-3 stickRadius 0.15
# voisins (vrai) : fins et gris
color #1 #c9ccd1 target a
size #1 stickRadius 0.08
# #1 = vrai
color #1/F:379 #52514e target a
size #1/F:379 stickRadius 0.25
# #2 = hybride
color #2 #2a78d6 target a
# #3 = hybrid_chain_pep
color #3 #eb6834 target a
view #1/F:379

# --- utile ---
# masquer un modele : hide #3 models   (et show #3 models)
# vue detaillee (couleurs N/O, carte, etiquettes, distance de l'atome le plus faux, legende) : copier ces lignes dans ChimeraX
#   color #1/F:379 byhetero
#   color #2 byhetero
#   color #3 byhetero
#   open "/data/eyerly/pdb_cryoem_splits/9EY2/emd_50052.map"
#   volume #4 style mesh sdLevel 1.5 color #9ec5f4
#   volume zone #4 nearAtoms #1/F:379 range 3
#   label #1-2/F:379@N,C,CB atoms height 0.4
#   distance #1/F:379@NH2 #2/F:379@NH2
#   2dlabels text "Decalage : bon squelette et bon rotamere, atomes deplaces (forme 0.38 A apres superposition)" xpos 0.02 ypos 0.94 size 18 color black
