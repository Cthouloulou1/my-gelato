# Session generee par make_error_examples.py
# Rotamere : chi1 158 deg, chi3 137 deg, chi4 135 deg (squelette a 11 deg)
# gris epais : vrai residu ; gris fin : vrais voisins +/-3 ; bleu : hybrid_chain_pep
close session
set bgColor white
lighting soft
graphics silhouettes true width 1.5
open "/home/eyerly/dev/my-gelato/runs/chimerax_erreurs/test_2_3A/3_rotamere_3_8Z65_S67ARG/vrai.cif" name vrai
open "/home/eyerly/dev/my-gelato/runs/chimerax_erreurs/test_2_3A/3_rotamere_3_8Z65_S67ARG/hybrid_chain_pep.cif" name hybrid_chain_pep
cartoon hide
hide atoms
show #1-2 atoms
style #1-2 stick
size #1-2 stickRadius 0.15
# voisins (vrai) : fins et gris
color #1 #c9ccd1 target a
size #1 stickRadius 0.08
# #1 = vrai
color #1/S:67 #52514e target a
size #1/S:67 stickRadius 0.25
# #2 = hybrid_chain_pep
color #2 #2a78d6 target a
view #1/S:67

# --- utile ---
# masquer un modele : hide #3 models   (et show #3 models)
# vue detaillee (couleurs N/O, carte, etiquettes, distance de l'atome le plus faux, legende) : copier ces lignes dans ChimeraX
#   color #1/S:67 byhetero
#   color #2 byhetero
#   open "/data/eyerly/pdb_cryoem_splits/8Z65/emd_39792.map"
#   volume #3 style mesh sdLevel 1.5 color #9ec5f4
#   volume zone #3 nearAtoms #1/S:67 range 3
#   label #1-2/S:67@N,C,CB atoms height 0.4
#   distance #1/S:67@NE #2/S:67@NE
#   2dlabels text "Rotamere : chi1 158 deg, chi3 137 deg, chi4 135 deg (squelette a 11 deg)" xpos 0.02 ypos 0.94 size 18 color black
